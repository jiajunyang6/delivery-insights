# Application configuration. Edit and save before starting Docker Compose.
# Keep .env private; never commit credentials.

# 1. GitHub data source
# Required for GitHub sync. Fine-grained token: Public repositories, read-only.
GITHUB_TOKEN=
# Comma-separated GitHub repositories in owner/name format.
TRACKED_REPOS=bevyengine/bevy,rust-lang/rust-analyzer

# 2. LLM narratives: AWS Bedrock
# Required for LLM-generated narratives.
# Without a key, narratives use deterministic templates and no LLM calls are made.
AWS_BEARER_TOKEN_BEDROCK=
# AWS region used for Bedrock requests.
AWS_REGION=us-west-2
# Bedrock model or inference profile ID used by the Converse API.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# 3. Sync and report precomputation
# Final history window (30-365 days); earlier backfill stages cover 7 and 30 days.
BACKFILL_DAYS=120
# Minutes between incremental syncs; must divide 60.
SYNC_INTERVAL_MINUTES=15
# Comma-separated report windows to precompute after sync, in days.
PRECOMPUTE_DAYS=7,30,60
# PRs per GraphQL page (5-50); reduce this if requests time out.
GRAPHQL_PAGE_SIZE=35

# 4. Analysis grouping
# Group PRs by label:<prefix> (directories when no label matches) or directory.
LOCATION_DIMENSION=label:area-

# 5. Database and cache connections
# Defaults use Docker service names; host-run services need reachable hosts and ports.
# PostgreSQL connection URL using the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://insights:insights@postgres:5432/insights
# Redis connection URL for task queues, caches, locks and rate limits.
REDIS_URL=redis://redis:6379/0

# 6. API and browser access
# Comma-separated browser origins allowed by the API.
CORS_ORIGINS=http://localhost:5173
# Maximum /v1/ API requests per client IP per minute.
RATE_LIMIT_PER_MINUTE=120

# 7. Logging
# Application logging level, for example INFO or DEBUG.
LOG_LEVEL=INFO
